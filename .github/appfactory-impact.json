{
  "version": 1,
  "fallback": "all",
  "ignorePaths": [
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "PASSATION*.md",
    "docs/**",
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    ".claude/**",
    "apps/**/README.md",
    "packages/**/README.md",
    "crates/**/README.md",
    "bench/README.md"
  ],
  "surfaces": {
    "core": {
      "paths": [
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "crates/vault-core/**"
      ],
      "gates": ["rust"]
    },
    "cli": {
      "paths": ["crates/vault-cli/**"],
      "gates": ["rust"],
      "dependsOn": ["core"]
    },
    "mount": {
      "paths": ["crates/vault-mount/**"],
      "gates": ["rust"],
      "dependsOn": ["core"]
    },
    "api": {
      "paths": ["crates/vault-api/**"],
      "gates": ["rust"],
      "dependsOn": ["core"]
    },
    "ci": {
      "paths": [".github/**"],
      "gates": ["rust"]
    }
  }
}
